# Port HTTP de l'application
PORT=3000
# Dossier des données (catalogue, prix, inventaire)
DATA_DIR=/var/lib/riftbound
# Authentification HTTP Basic (laisser vide pour désactiver)
AUTH_USER=
AUTH_PASSWORD=
# 1 = commit + push des rapports Markdown après chaque synchronisation
GIT_PUBLISH=1
GIT_BRANCH=main
