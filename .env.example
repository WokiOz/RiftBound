# Variables de la stack docker-compose.yml.
# - Déploiement Portainer (dépôt Git lié) : les saisir dans l'éditeur de stack
#   (marquer GIT_SSH_KEY_B64 et AUTH_PASSWORD comme "sensible").
# - Déploiement en ligne de commande : copier vers .env à côté de docker-compose.yml
#   (fichier à ne jamais committer).

# Port publié sur l'hôte (le conteneur écoute en interne sur 3000)
WEB_PORT=5901
# Authentification HTTP Basic (laisser vide pour désactiver)
AUTH_USER=
AUTH_PASSWORD=

# --- Publication des rapports Markdown sur GitHub ---
# 1 = commit + push de reports/ après chaque synchronisation
GIT_PUBLISH=1
GIT_BRANCH=main
# Dépôt SSH cloné automatiquement dans le volume "repo" au premier démarrage
GIT_REPO_URL=git@github.com:wokioz/riftbound.git
# Clé privée SSH (Deploy key du dépôt, accès en écriture), encodée en base64 :
#   ssh-keygen -t ed25519 -N "" -f git_ssh_key
#   base64 -w0 git_ssh_key
GIT_SSH_KEY_B64=
# Identité des commits automatiques
GIT_AUTHOR_NAME=Riftbound bot
GIT_AUTHOR_EMAIL=riftbound@localhost

# Intervalle entre deux synchronisations du service "sync", en secondes (86400 = 24h)
SYNC_INTERVAL_SECONDS=86400
