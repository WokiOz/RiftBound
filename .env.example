# Utilisé par docker-compose.yml. Copier vers .env à côté de docker-compose.yml.
# Ne pas committer ce fichier une fois rempli.

# Port HTTP publié par le service "web"
PORT=3000
# Authentification HTTP Basic (laisser vide pour désactiver)
AUTH_USER=
AUTH_PASSWORD=

# --- Publication des rapports Markdown sur GitHub ---
# 1 = commit + push de reports/ après chaque synchronisation
GIT_PUBLISH=1
GIT_BRANCH=main
# Dépôt SSH cloné automatiquement dans le volume "repo" au premier démarrage
GIT_REPO_URL=git@github.com:wokioz/riftbound.git
# Identité des commits automatiques
GIT_AUTHOR_NAME=Riftbound bot
GIT_AUTHOR_EMAIL=riftbound@localhost

# Intervalle entre deux synchronisations du service "sync", en secondes (86400 = 24h)
SYNC_INTERVAL_SECONDS=86400

# DATA_DIR et GIT_REPO_DIR ne sont pas définis ici : l'image utilise /data et /repo,
# qui correspondent aux volumes déclarés dans docker-compose.yml.
